# Visual Studio local workspace and user state
.vs/

# Common editor and operating-system local files
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates
.DS_Store
Thumbs.db

# Build output and platform workspace state
**/build/
**/.gradle/
**/.kotlin/
**/DerivedData/
**/xcuserdata/
**/*.xcuserstate
# Local Xcode test diagnostics captured under the retained .tmp evidence area.
.tmp/ios-diagnostics-*/
.tmp/swift-module-cache/
# Keep the same generated diagnostics ignored if a runner uses the non-dot tmp root.
tmp/ios-diagnostics-*/
ios/scripts/__pycache__/
# Local Gradle user home used by the Android test runner; never repository content.
android/.gradle-user-home/

# SBOM output (PCA-NFR-006) -- generated fresh by CI/local script, never committed
sbom.cdx.json

# Disposable real-backend E2E manifest -- contains test-only credentials/tokens
backend/qa-e2e-manifest.json

# Local configuration, credentials, and generated environment files
.env
.env.*
!.env.example
*.pem
*.p12
*.p8
*.keystore
*.jks
local.properties

# Claude / agent local worktrees and runtime state
.agent-runtime/
.claude/

# Local reviewer/coordinator runtime communication channel (Codex/Claude/DeepSeek).
# Not product source and not repository documentation: this is an inter-agent
# message transport, so it stays local. Findings that deserve a permanent record
# are promoted into docs/ deliberately rather than committed from here.
.agent-local-artifacts/
