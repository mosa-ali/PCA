# PCA backend -- MySQL connection configuration. Copy to .env and fill in
# real values; never commit .env. See backend/scripts/mysql/bootstrap-local.sql
# for creating the dedicated local pca_dev/pca_test databases and users.

# mysql2 accepts a full connection URI. Format:
#   mysql://<user>:<password>@<host>:<port>/<database>
PCA_DATABASE_URL=mysql://pca_dev_app:CHANGE_ME@127.0.0.1:3306/pca_dev

# The exact contract (PCA-PA-1 R2):
#   PCA_DATABASE_URL          = the application/runtime database principal.
#                                Read by backend/src/db/pool.ts and therefore
#                                by every ordinary repository/HTTP handler at
#                                request time -- the production process NEVER
#                                needs or consumes PCA_MIGRATION_DATABASE_URL.
#                                This is the credential `npm run test:db`
#                                (ordinary DB regression) exercises, and it
#                                is expected to be least-privilege (e.g. no
#                                UPDATE/DELETE on platform_admin_audit_events,
#                                no CREATE USER, no SUPER).
#   PCA_MIGRATION_DATABASE_URL = the deployment/test PROVISIONING principal,
#                                used ONLY when elevated schema/grant
#                                administration is genuinely required.
#
# Optional, with narrow exceptions below: scripts/migrate.mjs and
# scripts/verify-mysql.mjs fall back to PCA_DATABASE_URL when this is unset,
# for ordinary schema DDL (CREATE TABLE/ALTER TABLE) only -- a reasonable
# convenience for a single local-dev credential that already holds that DDL
# (see backend/scripts/mysql/bootstrap-local.sql).
#
# NO FALLBACK for privileged operations: scripts/provision-runtime-db-grants.mjs
# (GRANT/REVOKE) and the mandatory `npm run test:db:platform-admin-privileges`
# acceptance gate (CREATE USER + GRANT/REVOKE) REQUIRE this variable to be
# set explicitly and FAIL immediately if it is absent -- they never
# substitute PCA_DATABASE_URL for it. Silently doing so would either fail
# confusingly (the least-privilege runtime user genuinely cannot CREATE
# USER/GRANT) or, worse, mask a misconfiguration where the "runtime" URL
# actually points at an over-privileged account. Production SHOULD set this
# to a dedicated migration/provisioning credential, separate from the
# least-privilege runtime credential above -- that separation is what lets
# the runtime credential be denied UPDATE/DELETE on
# platform_admin_audit_events without also blocking migrations.
# PCA_MIGRATION_DATABASE_URL=mysql://pca_dev_admin:CHANGE_ME@127.0.0.1:3306/pca_dev

# Individual components, provided for tooling/bootstrap scripts that need
# them discretely rather than as a single URI.
PCA_DB_HOST=127.0.0.1
PCA_DB_PORT=3306
PCA_DB_NAME=pca_dev
PCA_DB_USER=pca_dev_app
PCA_DB_PASSWORD=CHANGE_ME

# Only needed to run backend/scripts/mysql/bootstrap-local.sql yourself
# (creating pca_dev/pca_test databases and their least-privilege app users).
# Never read by the application at runtime.
PCA_MYSQL_ADMIN_USER=root
PCA_MYSQL_ADMIN_PASSWORD=CHANGE_ME

# Backend HTTP server
PORT=4001
HOST=127.0.0.1
