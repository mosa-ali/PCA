# PCA Parent Web - environment configuration example
# Copy to .env (local dev) or .env.production (production build) and adjust.

# Base URL of the future PCA backend HTTP API. The browser NEVER talks to
# MySQL directly -- only through this typed HTTP boundary.
VITE_PCA_API_BASE_URL=http://localhost:4001

# Demo/fixture mode. When true, all data comes from clearly-labelled
# DEVELOPMENT_ONLY synthetic fixtures via the dev implementations of the
# typed API client interfaces (see src/api/dev). Must default to false in
# any production build.
VITE_PCA_DEMO_MODE=true

# One canonical public PCA origin for Child App enrollment links, proposed as
# the existing https://www.pcasafe.com domain. Parent appends /enroll/<one-time-token>;
# Android's App Link manifest accepts only /enroll/ on
# this same origin. Development defaults to http://localhost:4000. Production
# has no localhost or placeholder fallback. Keep this unset until the Public
# Web enrollment route and matching Digital Asset Links file have been verified
# at the chosen host; the Parent build validates URL syntax, not live routing.
# Supply this same PCA_CHILD_APP_PUBLIC_ORIGIN when building Android and pass it
# to the Parent container build as a public build argument.
# VITE_PCA_CHILD_APP_PUBLIC_ORIGIN=

# OPTIONAL -- selected Parent destination: the Public Web /child-app/ landing
# page on https://www.pcasafe.com. Keep the value unset until that route is
# deployed and verified. The landing page stays truthful while no signed
# installer is available.
#
# Absolute http(s) URL for the selected public installation-information page.
# Use the approved pcasafe.com path above only after Public Web deploys and
# verifies that route.
#
# The owner-selected production installation-information destination is the
# public landing page below. It may say that no signed installer is available
# yet; that page is useful before enrollment is enabled. An invalid value whose
# scheme is not HTTP or HTTPS is treated as unset by src/config/env.ts.
#
# The header's "Download App" action is always visible. When this destination
# is unset, its internal /download page states plainly that no Android
# installation information is configured for this environment. iOS is post-V1.
# Do not label the public landing page as a local test build. For a localhost
# Android debug APK only, set the distribution URL to its full absolute
# http://localhost URL and set VITE_PCA_CHILD_APP_DISTRIBUTION_KIND=local-test;
# relative paths are not accepted by src/config/env.ts.
# Production requires a real HTTPS destination; loopback and HTTP URLs are
# hidden from production bundles. Keep this destination even before the signed
# installer is ready; Add Device has its separate readiness gate below.
VITE_PCA_CHILD_APP_DISTRIBUTION_URL=https://www.pcasafe.com/child-app/
# For local APK testing only, set VITE_PCA_CHILD_APP_DISTRIBUTION_URL to the
# APK's absolute http://localhost URL and set this value:
# VITE_PCA_CHILD_APP_DISTRIBUTION_KIND=local-test

# Production invitation creation has a separate release gate. Leave false or
# unset until a signed Android release is published on the landing page and the
# live enrollment/App Link and Android asset association are verified.
# VITE_PCA_CHILD_APP_ENROLLMENT_READY=false
