# Keep repository text portable and deterministic. Binary artifacts must be
# explicitly declared by their future owning module.
* text=auto eol=lf

*.ps1 text eol=lf working-tree-encoding=UTF-8
*.psm1 text eol=lf working-tree-encoding=UTF-8
*.psd1 text eol=lf working-tree-encoding=UTF-8
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.gradle text eol=lf
*.kts text eol=lf
*.kt text eol=lf
*.swift text eol=lf
