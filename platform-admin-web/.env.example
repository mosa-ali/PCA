# Base URL of the backend HTTP API that serves the /platform-admin/* routes
# (see backend/src/http/routes/platformAdminAuthRoutes.ts). Never the same
# origin/session realm as parent-web's family-facing API.
#
# Leave this EMPTY/unset for normal local dev and every real deployment:
# this app has no CORS layer to fall back on, so requests must be
# same-origin -- an empty value (src/config/env.ts's default) makes every
# request relative to whatever origin this app itself is served from,
# which is what a reverse proxy (production) or vite's own dev proxy
# (VITE_E2E_REAL_PROXY_TARGET, see vite.config.ts) expects. Only set this
# to an explicit absolute origin if the backend is genuinely NOT reachable
# same-origin from wherever this app is served.
VITE_PCA_PLATFORM_ADMIN_API_BASE_URL=
