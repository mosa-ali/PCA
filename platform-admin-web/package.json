{
  "name": "pca-platform-admin-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PCA Platform Administration Web - operator/commercial control-plane console. Architecturally separate from parent-web; never shares a session, token, or RBAC model with the family-facing app.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 4100",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:real": "playwright test --config=playwright.real.config.ts"
  },
  "dependencies": {
    "i18next": "23.15.1",
    "i18next-browser-languagedetector": "8.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "15.0.2",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.5.0",
    "@testing-library/react": "16.0.1",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "22.5.5",
    "@types/react": "18.3.5",
    "@types/react-dom": "18.3.0",
    "@typescript-eslint/eslint-plugin": "8.5.0",
    "@typescript-eslint/parser": "8.5.0",
    "@vitejs/plugin-react": "4.7.0",
    "axe-core": "4.10.0",
    "eslint": "8.57.0",
    "eslint-plugin-jsx-a11y": "6.10.0",
    "eslint-plugin-react": "7.36.1",
    "eslint-plugin-react-hooks": "4.6.2",
    "eslint-plugin-react-refresh": "0.4.11",
    "jsdom": "25.0.0",
    "typescript": "5.5.4",
    "vite": "6.4.3",
    "vitest": "3.2.7",
    "vitest-axe": "0.1.0"
  }
}
