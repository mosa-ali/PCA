<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- PCA-7 location capability (org.pca.app.platform.LocationCapabilitySource):
         foreground location, checked at runtime via ContextCompat.checkSelfPermission.
         Neither is requested automatically; the runtime prompt flow is a separate,
         user-visible feature slice built on top of this capability adapter. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- StandardLocationCapabilitySource.backgroundState(): API 29+ background location,
         checked separately and live (never cached), see BackgroundLocationState. Per
         Android policy this must be requested in its own runtime prompt after foreground
         access is already granted, never bundled into the same request. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- PCA-WELL-1 (org.pca.app.feature.wellbeing.delivery.WellbeingNotificationDelivery):
         required on API 33+ to post the ordinary, dismissable "positive suggestion" notification
         (STANDARD_NOTIFICATION / LOCK_SCREEN_NOTIFICATION_BEST_EFFORT, doc 35 PCA-WELL-012).
         Checked at runtime via ContextCompat.checkSelfPermission before every notify() call;
         delivery degrades to SUPPRESSED_CAPABILITY_UNAVAILABLE (never a crash) if denied. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- PCA-RUNTIME-ANDROID-1 (org.pca.app.runtime.connectivity.NetworkConnectivityObserver):
         a normal (non-runtime-prompted) permission used only to report honest connectivity
         status and to know when a family-sync attempt might succeed. Never gates any local
         enforcement engine; see Section 0/10 of the runtime brief. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- PCA-RUNTIME-ANDROID-1 (org.pca.app.runtime.prayer.AlarmManagerPrayerScheduler): exact
         alarms are the only reliable way to fire a prayer-time reminder at its real wall-clock
         moment. Special access granted via Settings on API 31+, not a runtime permission dialog. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- PCA-5 (org.pca.app.feature.webprotection.vpn.WebProtectionVpnService): user consent for the
         VPN itself is obtained at runtime via VpnService.prepare() (see
         org.pca.app.platform.VpnCapabilitySource), never assumed from a manifest entry.
         FOREGROUND_SERVICE(_SPECIAL_USE) is required on API 34+ to legally run the persistent,
         non-hideable enforcement notification doc 25 Section 2 requires while the tunnel is
         active; the service itself (below) declares android:permission="BIND_VPN_SERVICE", the
         standard restriction that only the system may bind a VpnService. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:name=".PcaApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pca">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- PCA-ANDROID-ENROLLMENT-1: child-device setup entry point. The intent-filter's
             android:scheme/android:host MUST stay in exact sync with
             org.pca.app.enrollment.EnrollmentDeepLinkConfig (no wildcard host, so an arbitrary
             foreign link can never be treated as a valid invitation). Also directly launchable
             (no deep link) for the "Set up this device" entry point, since it declares no data
             requirement outside the intent-filter below. -->
        <activity
            android:name=".enrollment.EnrollmentActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="pca" android:host="enroll" />
            </intent-filter>
            <!-- PCA-ADD-ENR-008 (Writer63, additive-only): Android App Link continuation, so
                 tapping the invite link when the app is NOT yet installed can fall through to the
                 browser/Play Store and, once installed, deep-link back into this same activity.
                 A custom scheme (the intent-filter above) cannot do this, since the OS has nothing
                 registered for an unrecognized scheme until the app already exists on the device.
                 android:host MUST stay in exact sync with
                 org.pca.app.enrollment.EnrollmentDeepLinkConfig.APP_LINK_HOST (see that constant's
                 own doc comment). autoVerify="true" only takes effect once a real
                 assetlinks.json is hosted at this domain (a production/domain-infrastructure
                 decision outside this change); until then this filter is accepted but Android
                 falls back to its normal unverified-link disambiguation behavior, never a false
                 claim of working continuation before the domain is actually verified. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="enroll.pca.app" />
            </intent-filter>
        </activity>

        <!-- PCA-WEB-RUNTIME-1: the real child-facing Safe Browser surface. Not exported (launched
             only from within this app, e.g. a future ChildHomeScreen entry point) and declares no
             intent-filter of its own, so it can never collide with the enrollment deep link above
             or be launched by an arbitrary external app/link. -->
        <activity
            android:name=".feature.webprotection.ui.SafeBrowserActivity"
            android:exported="false" />

        <!-- PCA-5 (doc 14 layer 2): real, user-consented device-wide DNS-only web-filtering VPN.
             android:permission restricts binding to the system (standard VpnService contract);
             exported="true" is required for the system to bind it, but the intent-filter's action
             is the ONLY way it can be invoked; no other app-facing entry point exists. See
             org.pca.app.feature.webprotection.vpn.WebProtectionVpnService's own doc comment for the
             DNS-only scope decision and org.pca.app.feature.webprotection.vpn.VpnEnforcementController
             for the real start/stop orchestration seam. -->
        <!-- PCA-FR-073 (WRITER68 android-runtime-platform lane): the receiver that finally turns
             org.pca.app.runtime.prayer.AlarmManagerPrayerScheduler's already-correct exact alarm
             into a real, user-visible notification. exported="false": the sending PendingIntent
             is always created by this same app (setPackage(context.packageName) in
             org.pca.app.runtime.prayer.PrayerReminderIntents), so it never needs to be reachable
             from outside the app; the intent-filter below is required so the manifest-registered
             receiver actually matches the broadcast (API 26+ implicit-broadcast restriction). -->
        <receiver
            android:name=".runtime.prayer.PrayerReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="org.pca.app.action.PRAYER_REMINDER" />
            </intent-filter>
        </receiver>

        <!-- PCA-FR-045/PCA-FR-131 (WRITER69, additive-only): observes the documented
             PACKAGE_ADDED system broadcast to make newly installed apps visible to the
             parent-facing app list; see org.pca.app.runtime.installobserver.InstalledAppEventReceiver's
             own doc comment for the deliberately conservative scope (visibility only, no
             install-blocking approval gate; doc 03 marks that fuller workflow PROPOSED, not
             committed). exported="true" and the intent-filter's data scheme are required because
             PACKAGE_ADDED is an OS-sent system broadcast, not a self-sent one (contrast the
             PrayerReminderReceiver above); the receiver itself still verifies intent.action, so
             nothing but real PACKAGE_ADDED broadcasts for real package data URIs ever reach it. -->
        <receiver
            android:name=".runtime.installobserver.InstalledAppEventReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <!-- PCA-AND-RUNTIME-PLATFORM-1 (WRITER68): periodic usage-ingestion background job so
             collection survives process death, not just foreground/in-process execution; see
             org.pca.app.runtime.background.UsageIngestionWorker's own doc comment. WorkManager
             self-registers its own ContentProvider-based initializer from the work-runtime-ktx
             library's merged manifest; no explicit provider/service entry is needed here for
             the library itself, only the app enqueuing work against it
             (org.pca.app.runtime.background.WorkManagerBackgroundExecutionScheduler, called from
             PcaAppGraph.start()). -->

        <service
            android:name=".feature.webprotection.vpn.WebProtectionVpnService"
            android:exported="true"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="web_protection_vpn_content_filtering" />
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
    </application>
</manifest>

