<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- PCA-7 location capability (org.pca.app.platform.LocationCapabilitySource):
         foreground location, checked at runtime via ContextCompat.checkSelfPermission.
         Neither is requested automatically; the runtime prompt flow is a separate,
         user-visible feature slice built on top of this capability adapter. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- StandardLocationCapabilitySource.backgroundState(): API 29+ background location,
         checked separately and live (never cached), see BackgroundLocationState. Per
         Android policy this must be requested in its own runtime prompt after foreground
         access is already granted, never bundled into the same request. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- PCA-WELL-1 (org.pca.app.feature.wellbeing.delivery.WellbeingNotificationDelivery):
         required on API 33+ to post the ordinary, dismissable "positive suggestion" notification
         (STANDARD_NOTIFICATION / LOCK_SCREEN_NOTIFICATION_BEST_EFFORT, doc 35 PCA-WELL-012).
         Checked at runtime via ContextCompat.checkSelfPermission before every notify() call;
         delivery degrades to SUPPRESSED_CAPABILITY_UNAVAILABLE (never a crash) if denied. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pca">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>

