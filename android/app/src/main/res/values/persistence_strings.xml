<?xml version="1.0" encoding="utf-8"?>
<!--
  PCA-RUNTIME-PERSIST-1: strings for the Settings > Delete Now local-deletion
  flow (doc 11 Section 6, PCA-LOCAL-DB-1 Section 21). Follows the doc 20
  Section 2 string architecture used by strings.xml: stable ASCII keys,
  typed/positional placeholders, no runtime concatenation of fragments.
-->
<resources>
    <string name="delete_now_title">Delete Now</string>
    <string name="delete_now_description">Permanently deletes locally stored children\'s data for the scope you choose. This cannot be undone.</string>

    <string name="delete_now_scope_label">What to delete</string>
    <string name="delete_now_scope_device">This device only</string>
    <string name="delete_now_scope_child">%1$s (this child, all their devices)</string>
    <string name="delete_now_scope_family">All children</string>

    <string name="delete_now_confirm_title">Delete permanently?</string>
    <string name="delete_now_confirm_message">This will permanently delete the selected local data now. This cannot be undone.</string>
    <string name="delete_now_confirm_button">Delete now</string>
    <string name="delete_now_cancel_button">Cancel</string>

    <string name="delete_now_result_title">Deletion complete</string>
    <string name="delete_now_result_message">%1$d local records were deleted.\nReceipt: %2$s</string>
    <string name="delete_now_close_button">Close</string>

    <string name="delete_now_error_title">Delete Now failed</string>
    <string name="delete_now_error_message">The deletion could not be completed. No partial deletion was applied.</string>

    <!-- PCA-FR-124: Settings > Export audit records (local, unencrypted export). -->
    <string name="audit_export_title">Export audit records</string>
    <string name="audit_export_description">Saves a local record of this family\'s policy, role, retention, and deletion actions and tamper events as a JSON file you choose where to save. This file is not encrypted.</string>

    <string name="audit_export_result_title">Export complete</string>
    <string name="audit_export_result_message">The audit record was saved to the location you chose.</string>
    <string name="audit_export_close_button">Close</string>

    <string name="audit_export_error_title">Export failed</string>
    <string name="audit_export_error_message">The audit record could not be saved. No file was written.</string>
</resources>
