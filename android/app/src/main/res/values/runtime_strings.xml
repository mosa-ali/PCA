<?xml version="1.0" encoding="utf-8"?>
<!--
  PCA-RUNTIME-ANDROID-1 Section 19/20: runtime-shell (Child Home / status surface) strings.
  Same stable, ASCII, semantic message-ID convention as strings.xml, see that file's header
  comment. Kept in its own file since it is this worktree's own composition/runtime layer, not a
  single accepted-engine feature slice.
-->
<resources>
    <string name="child_home_title">Protection status</string>
    <!-- PCA-NFR-044: young-child reading-level variant, selected at runtime by AgeUxTier.YOUNG_CHILD
         via childHomeCopyForTier() in ChildHomeScreen.kt; same meaning, simpler wording. -->
    <string name="child_home_title_simple">Protection status</string>
    <string name="child_home_management_notice_title">PCA parental-control status</string>
    <string name="child_home_management_active">Parental controls are active on this device. Current restrictions and capability limits are shown below.</string>
    <string name="child_home_management_standard">PCA is present on this device in standard mode. Current restrictions and capability limits are shown below.</string>
    <string name="child_home_management_degraded">Protected authority is no longer available. PCA has downgraded its claims to the capabilities the device currently exposes.</string>
    <string name="child_home_management_authorization_required">PCA needs device authorization before stronger protection can apply. The current state is shown below.</string>
    <string name="child_home_management_not_supported">PCA protection is not supported by this device capability. The current state is shown below.</string>
    <string name="child_home_parent_visibility_title">What your parent can see</string>
    <string name="child_home_parent_visibility_body">Your parent can see protection status, screen-time and policy events, and activity categories enabled for your device. PCA does not store camera frames or facial identity as a children\'s monitoring history.</string>
    <!-- PCA-NFR-044: young-child reading-level variants of the two strings above. Same privacy
         substance (what a parent can and cannot see); never a shortened/hidden version; only
         sentence structure/vocabulary is simplified. -->
    <string name="child_home_parent_visibility_title_simple">What your parent can see</string>
    <string name="child_home_parent_visibility_body_simple">Your parent can see if protection is on, how much screen time you\'ve used, and what kind of apps or websites you use. Your parent cannot see your camera or your face.</string>

