    <!-- Wellbeing content catalogue copy: SKILLS_AND_LEARNING -->
    <string name="wellbeing_sugg_skills_1">Try 5 minutes of a new skill, like a language app or a puzzle.</string>
    <string name="wellbeing_sugg_skills_2">Watch a short how-to video and try the skill yourself.</string>
    <string name="wellbeing_sugg_skills_3">Practice typing, drawing, or an instrument for a few minutes.</string>
    <string name="wellbeing_sugg_skills_4">Learn three new facts about a topic you\'re curious about.</string>
    <string name="wellbeing_sugg_skills_5">Try a quick brain-teaser or logic puzzle.</string>

    <!-- READING -->
    <string name="wellbeing_sugg_reading_1">Read a few pages of a book you\'re enjoying.</string>
    <string name="wellbeing_sugg_reading_2">Read a short story or comic for a while.</string>
    <string name="wellbeing_sugg_reading_3">Read an article about something you find interesting.</string>
    <string name="wellbeing_sugg_reading_4">Curl up with a book for a longer reading session.</string>
    <string name="wellbeing_sugg_reading_5">Read a poem out loud.</string>

    <!-- FAITH_POSITIVE (optional, never a gate) -->
    <string name="wellbeing_sugg_faith_1">Take a quiet moment for a short prayer or reflection.</string>
    <string name="wellbeing_sugg_faith_2">Read a short passage from a book that means a lot to your family.</string>
    <string name="wellbeing_sugg_faith_3">Spend a few quiet minutes in reflection or gratitude.</string>
    <string name="wellbeing_sugg_faith_4">Listen to a short recitation or talk your family enjoys.</string>
    <string name="wellbeing_sugg_faith_5">Share something kind with a family member, inspired by your values.</string>

    <!-- GRATITUDE -->
    <string name="wellbeing_sugg_gratitude_1">Think of one thing that made you smile today.</string>
    <string name="wellbeing_sugg_gratitude_2">Tell someone in your family one thing you appreciate about them.</string>
    <string name="wellbeing_sugg_gratitude_3">Write down three small things you\'re grateful for.</string>
    <string name="wellbeing_sugg_gratitude_4">Send a kind note or message to someone you care about.</string>
    <string name="wellbeing_sugg_gratitude_5">Think back on a happy memory from this week.</string>

    <!-- GOOD_DEED -->
    <string name="wellbeing_sugg_gooddeed_1">Do one small kind thing for someone today.</string>
    <string name="wellbeing_sugg_gooddeed_2">Help a family member with something small, just because.</string>
    <string name="wellbeing_sugg_gooddeed_3">Write or draw a thank-you note for someone.</string>
    <string name="wellbeing_sugg_gooddeed_4">Give someone a genuine compliment.</string>
    <string name="wellbeing_sugg_gooddeed_5">Think of a way to help a friend, and try it out.</string>

    <!-- FAMILY_HELP -->
    <string name="wellbeing_sugg_familyhelp_1">Ask a family member if they need a hand with anything.</string>
    <string name="wellbeing_sugg_familyhelp_2">Help set or clear the table for a meal.</string>
    <string name="wellbeing_sugg_familyhelp_3">Help a younger sibling with something they\'re working on.</string>
    <string name="wellbeing_sugg_familyhelp_4">Offer to carry or organize something for a family member.</string>
    <string name="wellbeing_sugg_familyhelp_5">Spend some time helping with a family errand or project.</string>

    <!-- HOME_RESPONSIBILITY -->
    <string name="wellbeing_sugg_homeresp_1">Tidy up one small area of your room.</string>
    <string name="wellbeing_sugg_homeresp_2">Put away clothes or toys that are out of place.</string>
    <string name="wellbeing_sugg_homeresp_3">Help wipe down a counter or table with an adult\'s help.</string>
    <string name="wellbeing_sugg_homeresp_4">Make your bed.</string>
    <string name="wellbeing_sugg_homeresp_5">Help with a stove or oven task together with an adult.</string>

    <!-- CREATIVITY -->
    <string name="wellbeing_sugg_creativity_1">Doodle or sketch something for a few minutes.</string>
    <string name="wellbeing_sugg_creativity_2">Write a short story, poem, or song idea.</string>
    <string name="wellbeing_sugg_creativity_3">Build something with whatever craft materials you have on hand.</string>
