    "This is not a claim that PCA can never be removed from this device. A parent or guardian can always remove PCA through Apple's supported Family Controls settings and account recovery path. It does not prevent an authorized adult removal action." : {
      "comment" : "AntiRemovalClaimCopy.scopeQualifierText, the fixed PCA-IOS-002 qualification shown alongside every authorization state",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا لا يعني أنه لا يمكن إزالة PCA أبدًا من هذا الجهاز. يمكن لولي الأمر دائمًا إزالة PCA من خلال إعدادات Family Controls المعتمدة من Apple ومسار استرداد الحساب. وهذا لا يمنع إجراء إزالة معتمَدًا من شخص بالغ مخوَّل."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is not a claim that PCA can never be removed from this device. A parent or guardian can always remove PCA through Apple's supported Family Controls settings and account recovery path. It does not prevent an authorized adult removal action."
          }
        }
      }
    },
    "This protection is not available on this device or account right now." : {
      "comment" : "AntiRemovalClaimCopy.entitlementUnavailable statusDetail",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذه الحماية غير متاحة على هذا الجهاز أو الحساب حاليًا."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This protection is not available on this device or account right now."
          }
        }
      }
    },
    "This protection only takes effect after a parent or guardian completes Family Controls authorization for this device. It has not been requested yet." : {
      "comment" : "AntiRemovalClaimCopy.notDetermined statusDetail",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تصبح هذه الحماية سارية إلا بعد إتمام ولي الأمر تفويض Family Controls لهذا الجهاز. لم يُطلب ذلك بعد."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This protection only takes effect after a parent or guardian completes Family Controls authorization for this device. It has not been requested yet."
          }
        }
      }
    },
    "This protection requires an active parent/guardian Family Controls authorization, which is not currently granted for this device." : {
      "comment" : "AntiRemovalClaimCopy.denied statusDetail",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتطلب هذه الحماية تفويض Family Controls ساريًا من ولي الأمر، وهو غير ممنوح حاليًا لهذا الجهاز."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This protection requires an active parent/guardian Family Controls authorization, which is not currently granted for this device."
          }
        }
      }
    },
    "This protection was active but Family Controls authorization for this device has just changed. If this was not expected, ask your parent or guardian to check Screen Time settings." : {
      "comment" : "AntiRemovalClaimCopy.revoked statusDetail",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كانت هذه الحماية نشطة، لكن تفويض Family Controls لهذا الجهاز تغيّر للتو. إذا لم يكن هذا متوقعًا، فاطلب من ولي أمرك مراجعة إعدادات وقت الشاشة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This protection was active but Family Controls authorization for this device has just changed. If this was not expected, ask your parent or guardian to check Screen Time settings."
          }
        }
      }
    },
