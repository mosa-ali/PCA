    },
    "Your parent chose these starting settings for this device. Check them, then confirm to finish setup." : {
      "comment" : "PCAEnrollmentDisclosure.summary, teen reading level",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختار ولي أمرك إعدادات البداية هذه لهذا الجهاز. تحقّق منها، ثم أكِّد لإنهاء الإعداد."
          }
