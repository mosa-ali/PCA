    },
    "Your parent or guardian has authorized PCA for this child account through Family Controls, so iOS currently prevents deleting this app through ordinary means." : {
      "comment" : "AntiRemovalClaimCopy.approved statusDetail",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قام ولي أمرك بتفويض تطبيق PCA لحساب هذا الطفل عبر ميزة Family Controls، لذلك يمنع نظام iOS حاليًا حذف هذا التطبيق بالطرق المعتادة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your parent or guardian has authorized PCA for this child account through Family Controls, so iOS currently prevents deleting this app through ordinary means."
          }
        }
      }
    }
