    "PCA does not read your message or call content, save camera images, or keep a readable history of exact searches." : {
      "comment" : "PCAEnrollmentDisclosure.notMonitoredSummary, identical for every age tier",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يقرأ PCA محتوى رسائلك أو مكالماتك، ولا يحفظ صور الكاميرا، ولا يحتفظ بسجل قابل للقراءة لعمليات البحث الدقيقة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PCA does not read your message or call content, save camera images, or keep a readable history of exact searches."
          }
        }
      }
    },
    "PCA may show your parent protection status, screen-time totals, selected app or website categories, and requests you send." : {
      "comment" : "PCAEnrollmentDisclosure.monitoredSummary, identical for every age tier",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد يعرض PCA لولي أمرك حالة الحماية، وإجمالي وقت الشاشة، وفئات التطبيقات أو المواقع المحددة، والطلبات التي ترسلها."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PCA may show your parent protection status, screen-time totals, selected app or website categories, and requests you send."
          }
        }
      }
    },
