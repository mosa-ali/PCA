        ],
        "bonusGrants": [], "exceptions": [], "dailyLimit": null,
        "enforcementCapability": "ENFORCED", "connectivity": "ONLINE", "lastPolicySyncAtUtc": "2026-01-07T00:00:00.000Z"
      },
      "expected": { "decision": "INVALID_CONFIG", "hasConfigErrors": true }
    },
    {
      "id": "invalid-config-unrecognized-timezone-rejected",
      "description": "A window with an unrecognized IANA timezone string is rejected as INVALID_CONFIG rather than silently falling back to UTC or the input timezone.",
      "input": {
        "nowUtc": "2026-01-07T12:00:00.000Z",
        "timezone": "Asia/Riyadh",
        "appToken": "app-a",
        "windows": [
          { "id": "w1", "kind": "BLOCK_PERIOD", "daysOfWeek": [0,1,2,3,4,5,6], "start": { "hour": 0, "minute": 0 }, "end": { "hour": 23, "minute": 59 }, "appScope": "ALL", "timezone": "Not/ARealZone" }
        ],
        "bonusGrants": [], "exceptions": [], "dailyLimit": null,
        "enforcementCapability": "ENFORCED", "connectivity": "ONLINE", "lastPolicySyncAtUtc": "2026-01-07T00:00:00.000Z"
      },
      "expected": { "decision": "INVALID_CONFIG", "hasConfigErrors": true }
    },
    {
      "id": "exact-start-boundary-is-inclusive",
      "description": "A window is active at the exact instant equal to its local start time (inclusive lower bound).",
      "input": {
        "nowUtc": "2026-01-08T05:00:00.000Z",
