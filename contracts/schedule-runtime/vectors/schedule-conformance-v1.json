        "windows": [
          { "id": "w1", "kind": "BLOCK_PERIOD", "daysOfWeek": [4], "start": { "hour": 8, "minute": 0 }, "end": { "hour": 9, "minute": 0 }, "appScope": "ALL", "timezone": "Asia/Riyadh" }
        ],
        "bonusGrants": [], "exceptions": [], "dailyLimit": null,
        "enforcementCapability": "ENFORCED", "connectivity": "ONLINE", "lastPolicySyncAtUtc": "2026-01-07T00:00:00.000Z"
      },
      "expected": { "decision": "BLOCKED_PERIOD", "matchedWindowId": "w1" }
    },
    {
      "id": "exact-end-boundary-is-exclusive",
      "description": "The same window is NOT active at the exact instant equal to its local end time (exclusive upper bound).",
      "input": {
        "nowUtc": "2026-01-08T06:00:00.000Z",
        "timezone": "Asia/Riyadh",
        "appToken": "app-a",
        "windows": [
          { "id": "w1", "kind": "BLOCK_PERIOD", "daysOfWeek": [4], "start": { "hour": 8, "minute": 0 }, "end": { "hour": 9, "minute": 0 }, "appScope": "ALL", "timezone": "Asia/Riyadh" }
        ],
        "bonusGrants": [], "exceptions": [], "dailyLimit": null,
        "enforcementCapability": "ENFORCED", "connectivity": "ONLINE", "lastPolicySyncAtUtc": "2026-01-07T00:00:00.000Z"
