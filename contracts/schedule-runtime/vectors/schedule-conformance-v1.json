      "sourceScenario": "backend/test/schedule/engine.test.mjs: bonus grant extends the limit only while active, then reverts on expiry",
      "input": {
        "nowUtc": "2026-01-07T09:05:00.000Z",
        "timezone": "Asia/Riyadh",
        "appToken": "app-a",
        "windows": [], "exceptions": [],
        "bonusGrants": [
          { "id": "bonus-1", "appScope": "ALL", "extraMinutes": 15, "grantedAtUtc": "2026-01-07T09:00:00.000Z", "expiresAtUtc": "2026-01-07T09:15:00.000Z" }
        ],
        "dailyLimit": { "appScope": "ALL", "limitMinutes": 30, "usedMinutesToday": 30, "anchorLocalDate": "2026-01-07" },
        "enforcementCapability": "ENFORCED", "connectivity": "ONLINE", "lastPolicySyncAtUtc": "2026-01-07T00:00:00.000Z"
      },
      "expected": { "decision": "ALLOWED_BONUS", "remainingMinutesToday": 15 }
    },
    {
      "id": "bonus-grant-expired-reverts-to-limit-reached",
      "description": "The same bonus grant no longer applies once expired, reverting the app to BLOCKED_LIMIT_REACHED.",
      "sourceScenario": "backend/test/schedule/engine.test.mjs: bonus grant extends the limit only while active, then reverts on expiry",
      "input": {
        "nowUtc": "2026-01-07T09:20:00.000Z",
        "timezone": "Asia/Riyadh",
        "appToken": "app-a",
        "windows": [], "exceptions": [],
        "bonusGrants": [
          { "id": "bonus-1", "appScope": "ALL", "extraMinutes": 15, "grantedAtUtc": "2026-01-07T09:00:00.000Z", "expiresAtUtc": "2026-01-07T09:15:00.000Z" }
        ],
        "dailyLimit": { "appScope": "ALL", "limitMinutes": 30, "usedMinutesToday": 30, "anchorLocalDate": "2026-01-07" },
        "enforcementCapability": "ENFORCED", "connectivity": "ONLINE", "lastPolicySyncAtUtc": "2026-01-07T00:00:00.000Z"
      },
      "expected": { "decision": "BLOCKED_LIMIT_REACHED", "remainingMinutesToday": 0 }
    },
    {
      "id": "daily-limit-reached-blocks-same-timezone",
      "description": "Used minutes at or above the plain daily limit, anchored to today's local date, blocks the app.",
      "sourceScenario": "backend/test/schedule/engine.test.mjs: timezone change alone can flip the daily-limit local-date reset",
      "input": {
        "nowUtc": "2026-01-07T12:00:00.000Z",
        "timezone": "Asia/Riyadh",
        "appToken": "app-a",
        "windows": [], "exceptions": [], "bonusGrants": [],
        "dailyLimit": { "appScope": "ALL", "limitMinutes": 30, "usedMinutesToday": 30, "anchorLocalDate": "2026-01-07" },
        "enforcementCapability": "ENFORCED", "connectivity": "ONLINE", "lastPolicySyncAtUtc": "2026-01-07T00:00:00.000Z"
      },
      "expected": { "decision": "BLOCKED_LIMIT_REACHED", "remainingMinutesToday": 0 }
    },
    {
      "id": "daily-limit-reset-by-travelled-timezone",
      "description": "The exact same instant, evaluated in a different current timezone (travel), no longer matches the limit's anchorLocalDate, so the used-minutes figure is treated as reset and the app is allowed.",
      "sourceScenario": "backend/test/schedule/engine.test.mjs: timezone change alone can flip the daily-limit local-date reset",
      "input": {
        "nowUtc": "2026-01-07T12:00:00.000Z",
        "timezone": "Pacific/Kiritimati",
        "appToken": "app-a",
        "windows": [], "exceptions": [], "bonusGrants": [],
        "dailyLimit": { "appScope": "ALL", "limitMinutes": 30, "usedMinutesToday": 30, "anchorLocalDate": "2026-01-07" },
        "enforcementCapability": "ENFORCED", "connectivity": "ONLINE", "lastPolicySyncAtUtc": "2026-01-07T00:00:00.000Z"
      },
      "expected": { "decision": "ALLOWED" }
    },
    {
      "id": "travel-does-not-relax-window-anchored-to-family-timezone",
      "description": "A bedtime window is always evaluated in ITS OWN authored timezone (Asia/Riyadh), never the evaluation input's current timezone (America/Los_Angeles) -- a travelling child cannot relax a family-authored bedtime just by the device reporting a different local timezone.",
      "input": {
        "nowUtc": "2026-01-07T20:00:00.000Z",
        "timezone": "America/Los_Angeles",
        "appToken": "app-a",
        "windows": [
          { "id": "bedtime", "kind": "BEDTIME", "daysOfWeek": [0,1,2,3,4,5,6], "start": { "hour": 22, "minute": 0 }, "end": { "hour": 6, "minute": 0 }, "appScope": "ALL", "timezone": "Asia/Riyadh" }
        ],
        "bonusGrants": [], "exceptions": [], "dailyLimit": null,
        "enforcementCapability": "ENFORCED", "connectivity": "ONLINE", "lastPolicySyncAtUtc": "2026-01-07T00:00:00.000Z"
      },
      "expected": { "decision": "BLOCKED_BEDTIME", "matchedWindowId": "bedtime" }
    },
    {
      "id": "dst-spring-forward-before-shift-blocks",
      "description": "Before the America/New_York spring-forward, local 02:30-03:30 is within a fixed 02:00-03:00 window's absolute UTC mapping (offset -05:00).",
      "sourceScenario": "backend/test/schedule/engine.test.mjs: DST transition shifts which UTC instant maps to a fixed local bedtime hour",
      "input": {
        "nowUtc": "2026-03-01T07:30:00.000Z",
        "timezone": "America/New_York",
        "appToken": "app-a",
        "windows": [
          { "id": "bedtime", "kind": "BEDTIME", "daysOfWeek": [0,1,2,3,4,5,6], "start": { "hour": 2, "minute": 0 }, "end": { "hour": 3, "minute": 0 }, "appScope": "ALL", "timezone": "America/New_York" }
        ],
        "bonusGrants": [], "exceptions": [], "dailyLimit": null,
        "enforcementCapability": "ENFORCED", "connectivity": "ONLINE", "lastPolicySyncAtUtc": "2026-01-07T00:00:00.000Z"
      },
      "expected": { "decision": "BLOCKED_BEDTIME", "matchedWindowId": "bedtime" }
    },
    {
      "id": "dst-spring-forward-after-shift-no-longer-blocks-same-utc-instant",
      "description": "The identical UTC wall-clock-of-day, evaluated after the spring-forward, now falls outside the window in local time because the UTC offset shifted -- proving the engine tracks local wall time via IANA zone data, not a fixed UTC offset.",
      "sourceScenario": "backend/test/schedule/engine.test.mjs: DST transition shifts which UTC instant maps to a fixed local bedtime hour",
      "input": {
        "nowUtc": "2026-03-15T07:30:00.000Z",
        "timezone": "America/New_York",
        "appToken": "app-a",
        "windows": [
          { "id": "bedtime", "kind": "BEDTIME", "daysOfWeek": [0,1,2,3,4,5,6], "start": { "hour": 2, "minute": 0 }, "end": { "hour": 3, "minute": 0 }, "appScope": "ALL", "timezone": "America/New_York" }
        ],
        "bonusGrants": [], "exceptions": [], "dailyLimit": null,
        "enforcementCapability": "ENFORCED", "connectivity": "ONLINE", "lastPolicySyncAtUtc": "2026-01-07T00:00:00.000Z"
      },
      "expected": { "decision": "ALLOWED" }
    },
    {
      "id": "dst-fall-back-before-transition-blocks",
      "description": "Before the America/New_York fall-back (2026-11-01), local 01:30 EDT (UTC-04:00) is inside a fixed 01:00-02:00 window.",
      "input": {
        "nowUtc": "2026-10-01T05:30:00.000Z",
        "timezone": "America/New_York",
        "appToken": "app-a",
        "windows": [
          { "id": "bedtime", "kind": "BEDTIME", "daysOfWeek": [0,1,2,3,4,5,6], "start": { "hour": 1, "minute": 0 }, "end": { "hour": 2, "minute": 0 }, "appScope": "ALL", "timezone": "America/New_York" }
        ],
        "bonusGrants": [], "exceptions": [], "dailyLimit": null,
        "enforcementCapability": "ENFORCED", "connectivity": "ONLINE", "lastPolicySyncAtUtc": "2026-01-07T00:00:00.000Z"
      },
      "expected": { "decision": "BLOCKED_BEDTIME", "matchedWindowId": "bedtime" }
    },
    {
      "id": "dst-fall-back-after-transition-still-blocks-same-local-time",
      "description": "After the fall-back, local 01:30 EST (UTC-05:00, a different absolute UTC offset) is still inside the same fixed 01:00-02:00 window -- the engine's local-wall-clock semantics are unaffected by the standard/daylight offset change.",
      "input": {
        "nowUtc": "2026-11-08T06:30:00.000Z",
        "timezone": "America/New_York",
        "appToken": "app-a",
        "windows": [
          { "id": "bedtime", "kind": "BEDTIME", "daysOfWeek": [0,1,2,3,4,5,6], "start": { "hour": 1, "minute": 0 }, "end": { "hour": 2, "minute": 0 }, "appScope": "ALL", "timezone": "America/New_York" }
        ],
        "bonusGrants": [], "exceptions": [], "dailyLimit": null,
        "enforcementCapability": "ENFORCED", "connectivity": "ONLINE", "lastPolicySyncAtUtc": "2026-01-07T00:00:00.000Z"
      },
      "expected": { "decision": "BLOCKED_BEDTIME", "matchedWindowId": "bedtime" }
    },
    {
      "id": "all-apps-scope-blocks-any-app-token",
      "description": "A BLOCK_PERIOD with appScope ALL blocks an arbitrary app token.",
      "input": {
        "nowUtc": "2026-01-07T08:00:00.000Z",
        "timezone": "Asia/Riyadh",
        "appToken": "any-random-app",
        "windows": [
          { "id": "w1", "kind": "BLOCK_PERIOD", "daysOfWeek": [0,1,2,3,4,5,6], "start": { "hour": 0, "minute": 0 }, "end": { "hour": 23, "minute": 59 }, "appScope": "ALL", "timezone": "Asia/Riyadh" }
        ],
        "bonusGrants": [], "exceptions": [], "dailyLimit": null,
        "enforcementCapability": "ENFORCED", "connectivity": "ONLINE", "lastPolicySyncAtUtc": "2026-01-07T00:00:00.000Z"
      },
      "expected": { "decision": "BLOCKED_PERIOD", "matchedWindowId": "w1" }
    },
    {
      "id": "specific-app-scope-does-not-block-other-app",
      "description": "A BLOCK_PERIOD scoped to one specific app token does not affect a different app token.",
      "input": {
        "nowUtc": "2026-01-07T08:00:00.000Z",
        "timezone": "Asia/Riyadh",
        "appToken": "app-b",
        "windows": [
          { "id": "w1", "kind": "BLOCK_PERIOD", "daysOfWeek": [0,1,2,3,4,5,6], "start": { "hour": 0, "minute": 0 }, "end": { "hour": 23, "minute": 59 }, "appScope": { "apps": ["app-a"] }, "timezone": "Asia/Riyadh" }
        ],
        "bonusGrants": [], "exceptions": [], "dailyLimit": null,
        "enforcementCapability": "ENFORCED", "connectivity": "ONLINE", "lastPolicySyncAtUtc": "2026-01-07T00:00:00.000Z"
      },
      "expected": { "decision": "ALLOWED" }
    },
    {
      "id": "specific-app-scope-blocks-named-app",
      "description": "The same BLOCK_PERIOD blocks the app token it names.",
      "input": {
        "nowUtc": "2026-01-07T08:00:00.000Z",
        "timezone": "Asia/Riyadh",
        "appToken": "app-a",
        "windows": [
          { "id": "w1", "kind": "BLOCK_PERIOD", "daysOfWeek": [0,1,2,3,4,5,6], "start": { "hour": 0, "minute": 0 }, "end": { "hour": 23, "minute": 59 }, "appScope": { "apps": ["app-a"] }, "timezone": "Asia/Riyadh" }
        ],
        "bonusGrants": [], "exceptions": [], "dailyLimit": null,
        "enforcementCapability": "ENFORCED", "connectivity": "ONLINE", "lastPolicySyncAtUtc": "2026-01-07T00:00:00.000Z"
      },
      "expected": { "decision": "BLOCKED_PERIOD", "matchedWindowId": "w1" }
    },
    {
      "id": "capability-degraded-reports-enforcement-unavailable",
      "description": "When the enforcement capability is not ENFORCED and the intended decision is restrictive, the engine reports ENFORCEMENT_UNAVAILABLE with the honest intended decision rather than a bare block.",
      "sourceScenario": "backend/test/schedule/engine.test.mjs: precedence: enforcement-unavailable reports the intended decision instead of a bare block",
      "input": {
        "nowUtc": "2026-01-07T12:00:00.000Z",
        "timezone": "Asia/Riyadh",
        "appToken": "app-a",
        "windows": [
          { "id": "bedtime", "kind": "BEDTIME", "daysOfWeek": [0,1,2,3,4,5,6], "start": { "hour": 0, "minute": 0 }, "end": { "hour": 23, "minute": 59 }, "appScope": "ALL", "timezone": "Asia/Riyadh" }
        ],
        "bonusGrants": [], "exceptions": [], "dailyLimit": null,
        "enforcementCapability": "UNAVAILABLE", "connectivity": "ONLINE", "lastPolicySyncAtUtc": "2026-01-07T00:00:00.000Z"
      },
      "expected": { "decision": "ENFORCEMENT_UNAVAILABLE", "intendedDecision": "BLOCKED_BEDTIME" }
    },
    {
      "id": "capability-degraded-blocks-restrictive-decision",
      "description": "DEGRADED capability, like UNAVAILABLE, suppresses a restrictive intended decision in favor of an honest ENFORCEMENT_UNAVAILABLE verdict.",
      "input": {
        "nowUtc": "2026-01-07T12:00:00.000Z",
        "timezone": "Asia/Riyadh",
        "appToken": "app-a",
        "windows": [
          { "id": "bedtime", "kind": "BEDTIME", "daysOfWeek": [0,1,2,3,4,5,6], "start": { "hour": 0, "minute": 0 }, "end": { "hour": 23, "minute": 59 }, "appScope": "ALL", "timezone": "Asia/Riyadh" }
        ],
        "bonusGrants": [], "exceptions": [], "dailyLimit": null,
        "enforcementCapability": "DEGRADED", "connectivity": "ONLINE", "lastPolicySyncAtUtc": "2026-01-07T00:00:00.000Z"
      },
      "expected": { "decision": "ENFORCEMENT_UNAVAILABLE", "intendedDecision": "BLOCKED_BEDTIME" }
    },
    {
      "id": "capability-unavailable-does-not-suppress-allowed",
      "description": "A non-ENFORCED capability never suppresses an ALLOWED verdict -- only restrictive verdicts require confirmed enforcement.",
      "sourceScenario": "backend/test/schedule/engine.test.mjs: enforcement-unavailable does not suppress an ALLOWED verdict",
      "input": {
        "nowUtc": "2026-01-07T12:00:00.000Z",
        "timezone": "Asia/Riyadh",
        "appToken": "app-a",
        "windows": [], "exceptions": [], "bonusGrants": [], "dailyLimit": null,
        "enforcementCapability": "UNAVAILABLE", "connectivity": "ONLINE", "lastPolicySyncAtUtc": "2026-01-07T00:00:00.000Z"
      },
      "expected": { "decision": "ALLOWED" }
    },
    {
      "id": "offline-evaluation-matches-online-for-same-cached-policy",
      "description": "OFFLINE connectivity produces the identical decision to ONLINE given the same cached policy inputs -- connectivity is never itself an input to the decision.",
      "sourceScenario": "backend/test/schedule/engine.test.mjs: offline evaluation is identical to online evaluation given the same cached policy",
      "input": {
        "nowUtc": "2026-01-07T12:00:00.000Z",
        "timezone": "Asia/Riyadh",
        "appToken": "app-a",
        "windows": [
          { "id": "bedtime", "kind": "BEDTIME", "daysOfWeek": [0,1,2,3,4,5,6], "start": { "hour": 0, "minute": 0 }, "end": { "hour": 23, "minute": 59 }, "appScope": "ALL", "timezone": "Asia/Riyadh" }
        ],
        "bonusGrants": [], "exceptions": [], "dailyLimit": null,
        "enforcementCapability": "ENFORCED", "connectivity": "OFFLINE", "lastPolicySyncAtUtc": "2026-01-06T00:00:00.000Z"
      },
      "expected": { "decision": "BLOCKED_BEDTIME", "matchedWindowId": "bedtime" }
    },
    {
      "id": "offline-restart-with-no-policy-sync-yet-evaluates-deterministically",
      "description": "A device offline since before its first policy sync (lastPolicySyncAtUtc null) still evaluates deterministically off whatever cached (here, empty) policy it holds -- it never blocks or allows purely because sync status is unknown.",
      "sourceScenario": "backend/test/schedule/engine.test.mjs: offline restart with no policy sync yet still evaluates deterministically off cached (empty) policy",
      "input": {
        "nowUtc": "2026-01-07T12:00:00.000Z",
        "timezone": "Asia/Riyadh",
        "appToken": "app-a",
        "windows": [], "exceptions": [], "bonusGrants": [], "dailyLimit": null,
        "enforcementCapability": "ENFORCED", "connectivity": "OFFLINE", "lastPolicySyncAtUtc": null
      },
      "expected": { "decision": "ALLOWED" }
    },
    {
      "id": "invalid-config-out-of-range-hour-rejected",
      "description": "A window with an out-of-range start hour is rejected as INVALID_CONFIG without crashing and without silently allowing.",
      "sourceScenario": "backend/test/schedule/engine.test.mjs: invalid window configuration is rejected without crashing and without silently allowing",
      "input": {
        "nowUtc": "2026-01-07T12:00:00.000Z",
        "timezone": "Asia/Riyadh",
