        "windows": [
          { "id": "w1", "kind": "BLOCK_PERIOD", "daysOfWeek": [0,1,2,3,4,5,6], "start": { "hour": 99, "minute": 0 }, "end": { "hour": 23, "minute": 59 }, "appScope": "ALL", "timezone": "Asia/Riyadh" }
        ],
        "bonusGrants": [], "exceptions": [], "dailyLimit": null,
        "enforcementCapability": "ENFORCED", "connectivity": "ONLINE", "lastPolicySyncAtUtc": "2026-01-07T00:00:00.000Z"
      },
      "expected": { "decision": "INVALID_CONFIG", "hasConfigErrors": true }
    },
    {
      "id": "invalid-config-empty-days-of-week-rejected",
      "description": "A window with an empty daysOfWeek list is rejected as INVALID_CONFIG.",
      "sourceScenario": "backend/test/schedule/engine.test.mjs: empty daysOfWeek is rejected as invalid configuration",
